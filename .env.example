# AWS S3 (stores uploaded PDFs; the pdfs/ prefix must be publicly readable so Lob can fetch them)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Stripe (payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Lob (physical mail delivery)
LOB_API_KEY=

# MPP — Machine Payments Protocol (agent-facing /api/agent/mail endpoint)
# Settles through Stripe via Shared Payment Tokens, so it reuses STRIPE_SECRET_KEY above.
# MPP_SECRET_KEY binds payment challenges to the server (HMAC); generate a strong random value.
MPP_SECRET_KEY=
# Stripe network id used for MPP charges (e.g. "internal").
MPP_NETWORK_ID=internal
# Optional realm advertised in 402 challenges; defaults to the deployment host.
MPP_REALM=
