# AWS S3 (stores uploaded PDFs; the pdfs/ prefix must be publicly readable so Lob can fetch them)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Stripe (payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Lob (physical mail delivery)
LOB_API_KEY=

# Machine Payments Protocol (MPP) — HMAC secret that binds payment challenges.
# Generate with: openssl rand -hex 32
MPP_SECRET_KEY=
# Optional: realm advertised in payment challenges (defaults to "print-mail-service").
MPP_REALM=
